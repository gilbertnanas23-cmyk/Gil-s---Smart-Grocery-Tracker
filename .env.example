# ==============================================================================
# Smart Grocery & Price Tracker - Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Configuration (Wajib untuk Supabase Auth & PostgreSQL)
# Dapatkan dari: Supabase Dashboard > Project Settings > API
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Catatan Google OAuth di Supabase:
# 1. Aktifkan provider Google di: Supabase Dashboard > Authentication > Providers > Google.
# 2. Masukkan Google Client ID dan Google Client Secret dari Google Cloud Console.
# 3. Masukkan Callback URL Supabase (https://<project-ref>.supabase.co/auth/v1/callback)
#    ke Authorized Redirect URIs di Google Cloud Console.
# 4. Di Supabase Dashboard > Authentication > URL Configuration:
#    - Site URL: https://your-project.vercel.app (atau http://localhost:5173 untuk dev)
#    - Redirect URLs: Tambahkan http://localhost:5173/** dan https://*.vercel.app/**

# ------------------------------------------------------------------------------
# 2. Firebase Cloud Configuration (Opsional - Fallback Cadangan)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
